{
  "name": "openpack",
  "version": "0.5.0",
  "description": "Open-source offline content packs and local Wi-Fi boxes for places where data is expensive or unavailable. Myanmar-first.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "openpack": "bin/openpack.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js && cd server && go test ./...",
    "build:server": "bash scripts/build-server.sh",
    "build:example": "node bin/openpack.js build packs/example",
    "bundle": "bash scripts/make-bundle.sh",
    "e2e": "bash scripts/e2e.sh",
    "browser-test": "python3 scripts/browser-test.py",
    "release": "bash scripts/weekly-release.sh",
    "pin": "node scripts/pin-source.js",
    "review-sheet": "node scripts/make-review-sheet.js",
    "review-packet": "node scripts/make-review-packet.js",
    "lint:sh": "shellcheck -S warning scripts/*.sh box/*.sh bundle/*.sh"
  },
  "keywords": [
    "offline",
    "mesh",
    "content-distribution",
    "myanmar",
    "el-paquete",
    "kiwix",
    "kolibri"
  ]
}
