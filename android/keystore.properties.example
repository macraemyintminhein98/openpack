# Copy to android/keystore.properties and fill in. Never commit the real file or the keystore.
#
# Make the keystore once, on your own computer, and back it up somewhere offline:
#   keytool -genkeypair -v -keystore openpack-release.jks -alias openpack \
#           -keyalg RSA -keysize 4096 -validity 20000
# Lose it and installed phones can never be updated. Leak it and someone else can update them.
storeFile=../../keys/openpack-release.jks
storePassword=CHANGE-ME
keyAlias=openpack
keyPassword=CHANGE-ME
