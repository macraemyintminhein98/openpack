<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is used only between phones on the same local network, and to the app's own
     server on this phone. The code refuses any address that is not a local-network number
     (see PeerSync.isLocalAddress), and every pack is signature-checked whatever it came over. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
